/build/
# The copy of hylad's code that package buildinfo embeds, which the
# build makes, and a commit of changed hylad code skips (git diff
# -- ':!internal/buildinfo/_hyladSource').
/internal/buildinfo/_hyladSource/
/.mygo/
mygo_windows_*.syso
node_modules/
.DS_Store
/hyla
/hyla.exe

# Local agent tools: not hyla's files. They made the tree dirty, and the
# 30-minute upstream sync refused every run.
/.agents/
/.claude/skills/
/agent/
/skills-lock.json
scripts/signing/*
!scripts/signing/hyla-signing.crt
scripts/signing.pw
.signing/
/plugins/*/bin/
/plugins/*/*.hylapkg

# Local release notes and signing setup, kept out of the repository.
/RELEASING.md
/scripts/sign-macos.sh
